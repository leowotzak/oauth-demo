# How this service checks JWT access tokens. No secrets: it only needs
# auth-server's public keys, and the values tokens must carry.
JWKS_URL=http://localhost:8080/.well-known/jwks.json
ISSUER=http://localhost:8080
AUDIENCE=notes-api

# Redis, for notes and the list of revoked token IDs. Locally: docker compose up -d redis
REDIS_URL=redis://localhost:6379/0
